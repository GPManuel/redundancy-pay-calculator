---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '../styles/global.css';
import { NOMBRE_SITIO, REVISION } from '../lib/sitio';

interface Props {
  title: string;
  description: string;
  /** Páginas que no deben aparecer en buscadores (p. ej. la 404). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imagen = new URL(`${base}/og-image.png`, Astro.site);
const imagenAlt = 'Calculadora de indemnización por despido: icono de calculadora con el símbolo del euro';
const path = Astro.url.pathname.replace(/\/$/, '');

const nav = [
  { href: `${base}/`, label: 'Calculadora', activo: path === base },
  { href: `${base}/como-se-calcula/`, label: 'Cómo se calcula', activo: path === `${base}/como-se-calcula` },
  { href: `${base}/antes-de-firmar/`, label: 'Antes de firmar', activo: path === `${base}/antes-de-firmar` },
  // En móvil no cabe: las preguntas frecuentes siguen enlazadas desde «Cómo se calcula»
  { href: `${base}/como-se-calcula/#faq`, label: 'Preguntas frecuentes', activo: false, soloEscritorio: true },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={NOMBRE_SITIO} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagenAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <meta name="theme-color" content="#0f6e6e" />
    <script is:inline>
      // Aplica el tema elegido antes de pintar, para evitar un parpadeo
      try {
        const t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="contenedor site-header__inner">
        <a href={`${base}/`} class="marca">
          <span class="marca__logo" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 32 32">
              <rect width="32" height="32" rx="7" fill="#0f6e6e"></rect>
              <rect x="7" y="4" width="18" height="24" rx="3.5" fill="#fff"></rect>
              <rect x="10" y="7" width="12" height="5.5" rx="1.5" fill="#10292b"></rect>
              <rect x="15.5" y="8.9" width="5" height="1.7" rx=".85" fill="#ffb38a"></rect>
              <path d="M19.6 17A4.6 4.6 0 1 0 19.6 24" fill="none" stroke="#0f6e6e" stroke-width="2.2" stroke-linecap="round"></path>
              <path d="M10.6 19.4h6M10.6 21.6h6" fill="none" stroke="#0f6e6e" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="marca__nombre">Calculadora de indemnización</span>
        </a>
        <nav aria-label="Principal" class="nav" id="nav">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.activo ? 'page' : undefined} class={item.soloEscritorio ? 'nav__solo-escritorio' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <button type="button" class="tema" id="tema" aria-label="Cambiar a tema oscuro" title="Cambiar a tema oscuro">
          <svg class="tema__luna" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg class="tema__sol" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="contenedor">
        Cálculo orientativo según los arts. 51, 53 y 56 del Estatuto de los Trabajadores y la Ley 3/2012. No sustituye el
        asesoramiento de tu sindicato ni de un profesional. <a href={`${base}/antes-de-firmar/`}>Antes de firmar, lee esto</a>.
      </div>
      <div class="contenedor site-footer__meta">
        Contenido revisado en <time datetime={REVISION.iso}>{REVISION.texto}</time>. Fuentes:
        <a href={`${base}/como-se-calcula/#fuentes`}>normativa oficial</a>.
      </div>
    </footer>

    <script>
      const raiz = document.documentElement;
      const boton = document.getElementById('tema') as HTMLButtonElement;
      const sistemaOscuro = window.matchMedia('(prefers-color-scheme: dark)');

      const temaActual = () => raiz.dataset.theme ?? (sistemaOscuro.matches ? 'dark' : 'light');

      function etiquetar() {
        const texto = temaActual() === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro';
        boton.setAttribute('aria-label', texto);
        boton.title = texto;
      }

      boton.addEventListener('click', () => {
        const nuevo = temaActual() === 'dark' ? 'light' : 'dark';
        raiz.dataset.theme = nuevo;
        try {
          localStorage.setItem('tema', nuevo);
        } catch {}
        etiquetar();
      });

      sistemaOscuro.addEventListener('change', etiquetar);
      etiquetar();

      // Si el menú se desplaza en pantallas estrechas, deja visible la página actual
      const menu = document.getElementById('nav');
      const actual = menu?.querySelector<HTMLElement>('[aria-current="page"]');
      if (menu && actual && menu.scrollWidth > menu.clientWidth) {
        menu.scrollLeft = actual.offsetLeft - (menu.clientWidth - actual.offsetWidth) / 2;
      }
    </script>
  </body>
</html>
